{
  "name": "projeto-playwright",
  "version": "1.0.0",
  "description": "Projeto de automação de testes Web e API com Playwright e TypeScript",
  "author": "Lafaiete Rodrigues Machado",
  "license": "MIT",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:web": "playwright test --project=web",
    "test:api": "playwright test --project=api",
    "test:headed": "playwright test --project=web --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
